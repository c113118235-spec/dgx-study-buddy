# DGX 學伴的設定檔：複製成 deploy/.env 再填（install.sh 會自動做）
# 這個檔案有金鑰：chmod 600，不要 commit、不要貼到聊天或文件裡

# ===== 必填 =====
# 學校 iAI 平台金鑰（LLM 備援、iAI 語音）
IAI_API_KEY=
# 公開網址的通關碼（私下給使用者）
GF_ACCESS_CODE=

# ===== 選填 =====
# Cloudflare TURN（另一種 TURN 設定方式見 data/turn.json）
#CF_TURN_KEY_ID=
#CF_TURN_API_TOKEN=
# 語音辨識服務有設金鑰時才需要
#ASR_API_KEY=

# ===== 部署路徑與版本（install.sh 會自動填好）=====
# 映像版本，例如 20261122
XQ_VERSION=
# 模型資料夾（IndexTTS、Whisper、LivePortrait）
XQ_MODELS=
# IndexTTS 原始碼
XQ_INDEXTTS_SRC=
